<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 版本锁定：不使用版本区间与 SNAPSHOT -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.trustagent</groupId>
  <artifactId>trustagent-backend</artifactId>
  <version>0.1.0</version>
  <name>trustagent-backend</name>
  <description>TrustAgent Java control plane: auth, RBAC, agent policy, evaluation orchestration, tamper-evident audit</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <springdoc.version>2.8.17</springdoc.version>
    <jjwt.version>0.12.7</jjwt.version>
    <h2.version>2.3.232</h2.version>
  </properties>

  <dependencies>
    <!-- Web / 校验 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 安全 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- 持久化：MyBatis-Plus + Flyway + MySQL + H2(dev/test) -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <!--
      自 MyBatis-Plus 3.5.9 起分页插件从核心包拆出，PaginationInnerInterceptor 需要显式引入本模块。
      这里选默认实现（内置 JSqlParser 5.x）；如需兼容旧解析器可换成 mybatis-plus-jsqlparser-4.9。
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis：限流与评测任务队列 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- OpenAPI / Swagger UI -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- 工具 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      H2：只服务于 dev / test 这两种"零外部依赖"的运行方式，**不得进入生产制品**。

      为什么用 provided 而不是 test（这是实际踩出来的坑）：
        1) test 作用域在 `spring-boot:run` 时不进类路径，dev profile 会以
           "Cannot load driver class: org.h2.Driver" 直接启动失败 ——
           也就是说 application-dev.yml 宣称的"H2 + 内存限流/队列"是跑不起来的；
        2) provided 同时可见于 compile / test / run，`mvn test` 与"一条命令起 dev"都能工作；
        3) 但要注意：spring-boot 重打包**会**把 provided 依赖放进 fat jar（实测 h2 仍在
           BOOT-INF/lib 内），所以光靠作用域不够，还必须在 spring-boot-maven-plugin 的
           exclude 里显式排掉（见文件末尾），否则生产制品里会带一个用不到的数据库驱动。
           H2 的 JDBC URL 支持 INIT/RUNSCRIPT 之类的参数，是真实的可利用面，
           "用不到就不要带上"在这类安全项目里比省事更重要。
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <!--
    网络说明：部分国内网络会把 repo.maven.apache.org 解析到不可达地址（实测被劫持到 198.18.0.8 并超时）。
    这里用一个 id 同为 central 的仓库定义覆盖 super-POM 中的 central，指向阿里云公共镜像；
    不使用 <mirror> 是为了不改动使用者的全局 ~/.m2/settings.xml。
    若你的网络可直连 Maven Central，用 -Pno-cn-mirror 关闭即可。
  -->
  <repositories>
    <repository>
      <id>central</id>
      <name>central-override-aliyun</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>daily</updatePolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <name>central-override-aliyun</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>daily</updatePolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!--
          <excludes> **必须**放在 repackage 这个 execution 里，不能放在插件级 <configuration>。

          放在插件级会被 spring-boot:run 一并采用，于是连 dev 模式需要的 H2 也被踢出运行类路径，
          表现为启动即失败：Cannot load driver class: org.h2.Driver（这个坑踩了两次）。
          repackage 与 run 共用同一份插件级配置，但 execution 级配置只作用于该 execution。
        -->
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>
                  <groupId>org.projectlombok</groupId>
                  <artifactId>lombok</artifactId>
                </exclude>
                <!-- H2 只用于 dev / test，绝不能进生产制品（原因见 dependencies 里的注释） -->
                <exclude>
                  <groupId>com.h2database</groupId>
                  <artifactId>h2</artifactId>
                </exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 固定时区与语言环境：避免同一份断言在不同机器上因为 Locale 差异（小数点/大小写）时红时绿 -->
          <argLine>-Duser.timezone=UTC -Duser.language=en -Duser.country=US</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
