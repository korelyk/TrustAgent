# ============================================================================
# TrustAgent 环境变量示例
#
# 用法：复制为 .env 后按需填写。.env 已被 .gitignore 忽略，不会进入版本库。
#
# 重要约定
#   1. 本项目不硬编码任何 API Key / 密码 / Token；全部通过环境变量注入。
#   2. **本地开发**：一个变量都不配，也能以「MockLLM + H2 内存库 + 内存限流/队列」
#      跑通演示链路（见 README 快速启动）。
#      **部署到服务器**：下面标了「必填」的项缺失或仍是示例值时，服务会**拒绝启动**
#      （而不是默默用一个弱默认值跑起来）——这是刻意的 fail fast。
#      必需项：TRUSTAGENT_DB_*、TRUSTAGENT_REDIS_PASSWORD、
#              TRUSTAGENT_JWT_SECRET（>=32 字节）、TRUSTAGENT_INTERNAL_TOKEN、
#              TRUSTAGENT_IMAGE_TAG（仅 lowmem 部署）。
#   3. 不要把真实密钥写进本文件——它是要提交的。
#   4. 中文用户请注意：Windows PowerShell 里用
#      `$env:TRUSTAGENT_XXX="值"` 设置，或使用 scripts/ 下的启动脚本。
#   5. 服务器上的 .env 必须 chmod 600（里面有全部密钥）。
#      scripts/server/preflight.sh 会检查这一点并给出告警。
# ============================================================================

# ---------------------------------------------------------------------------
# Java 控制面（backend/）
# ---------------------------------------------------------------------------
TRUSTAGENT_SERVER_PORT=8080

# 数据库：默认 profile 使用 MySQL 8。
# 想零依赖联调请改用 --spring.profiles.active=dev（H2 文件库 + 内存限流/队列）。
TRUSTAGENT_DB_URL=jdbc:mysql://localhost:3306/trustagent?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
TRUSTAGENT_DB_USERNAME=trustagent
TRUSTAGENT_DB_PASSWORD=

# 仅 docker compose 需要：库名与 MySQL root 口令（本地开发用，勿用于任何真实环境）
TRUSTAGENT_DB_NAME=trustagent
TRUSTAGENT_DB_ROOT_PASSWORD=

# Redis 7：限流滑动窗口 + 评测任务 Stream（eval.jobs）
TRUSTAGENT_REDIS_HOST=localhost
TRUSTAGENT_REDIS_PORT=6379
TRUSTAGENT_REDIS_PASSWORD=
TRUSTAGENT_REDIS_DATABASE=0

# 用户 JWT。生产必须显式设置且长度 >= 32 字节。
# 留空时服务会生成"进程级随机密钥"并打印告警——仅可用于本地单机调试，重启即失效。
TRUSTAGENT_JWT_SECRET=
TRUSTAGENT_JWT_TTL_SECONDS=7200

# Java <-> Python 内部凭证（两条链路互相隔离，用户 JWT 打不开 /internal/**）。
# 两侧必须配置成同一个值；缺失时内部接口一律返回 401（fail closed），不会默认放行。
TRUSTAGENT_INTERNAL_TOKEN=
TRUSTAGENT_INTERNAL_HEADER=X-Internal-Token

# Python 执行面地址与超时
TRUSTAGENT_AI_SERVICE_BASE_URL=http://localhost:8000
TRUSTAGENT_AI_SERVICE_TIMEOUT_MS=20000

# 限流额度（每个滑动窗口内的最大请求数，窗口固定 60 秒）
TRUSTAGENT_RL_CHAT_LIMIT=30
TRUSTAGENT_RL_LOGIN_LIMIT=10
TRUSTAGENT_RL_EVAL_LIMIT=10

# 评测任务失败重试次数；超过后进入死信 Stream（eval.jobs.dlq）
TRUSTAGENT_EVAL_MAX_DELIVERIES=3
TRUSTAGENT_LOG_LEVEL=INFO

# 首个管理员账号：只在"库中没有任何用户"时创建。
# 留空则完全不创建（默认，最安全）。请使用强口令，并在首次登录后修改。
TRUSTAGENT_BOOTSTRAP_ADMIN_USERNAME=
TRUSTAGENT_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Python 执行面（ai-service/）
# ---------------------------------------------------------------------------
TRUSTAGENT_HOST=0.0.0.0
TRUSTAGENT_PORT=8000

# LLM 提供方：mock（默认）| openai_compatible
#   - mock：确定性输出，无需任何 Key，单元测试与评测基线都用它
#   - openai_compatible：兼容 OpenAI Chat Completions 协议的任何服务
TRUSTAGENT_LLM_PROVIDER=mock
TRUSTAGENT_LLM_MODEL=mock-llm-v1
TRUSTAGENT_OPENAI_BASE_URL=
TRUSTAGENT_OPENAI_API_KEY=
TRUSTAGENT_OPENAI_TIMEOUT_SECONDS=30

# 执行面的兜底上限：即使控制面策略配错，执行面也不会跑飞
TRUSTAGENT_HARD_MAX_INPUT_LENGTH=20000
TRUSTAGENT_HARD_MAX_TOOL_CALLS=10
TRUSTAGENT_HARD_TASK_TIMEOUT_MS=60000

# 演示文档检索：供 search_local_docs 工具使用（只读项目内演示文档，不碰真实文件系统）
#
# 留空 = 使用执行面内置默认值（ai-service/resources/demo_docs）。
# **不要**把这里留空的同时又在别处传空串覆盖：空值与"未设置"在执行面是两条路径，
#   若被当成一个空路径解析，目录会被解析成 "."（即整个 ai-service 目录），
#   间接注入用例拿到的检索上下文就完全不对了（执行面已做空值回落，这里是同一约定的文档侧说明）。
# 想启用必须填一个**相对仓库根的目录**，例如 ai-service/resources/demo_docs。
TRUSTAGENT_DEMO_DOCS_DIR=
TRUSTAGENT_DOC_SEARCH_TOP_K=3
TRUSTAGENT_DOC_SNIPPET_MAX_LENGTH=1200

# Mock Outbox：send_notification 只写本地 JSONL，不发送任何真实消息
#
# 留空 = 使用执行面内置默认值（ai-service/.data/mock_outbox.jsonl）。
# 同上：空值必须回落到默认路径，不能变成一个空文件名的写入目标。
TRUSTAGENT_OUTBOX_FILE=

# 评测 Worker（消费 eval.jobs）
TRUSTAGENT_EVAL_WORKER_ENABLED=true
TRUSTAGENT_REDIS_URL=redis://localhost:6379/0
TRUSTAGENT_EVAL_STREAM_KEY=eval.jobs
TRUSTAGENT_EVAL_DEAD_LETTER_KEY=eval.jobs.dlq
TRUSTAGENT_EVAL_CONSUMER_GROUP=cg:eval
TRUSTAGENT_EVAL_CONSUMER_NAME=worker-1
TRUSTAGENT_EVAL_READ_BLOCK_MS=5000
TRUSTAGENT_EVAL_BATCH_SIZE=20
# 一条消息多久没被 ACK 就允许别的消费者重新认领（毫秒）。
# 必须明显大于一条任务的最长执行时间，否则会出现"任务还在跑又被抢过去跑一遍"。
TRUSTAGENT_EVAL_RECLAIM_IDLE_MS=60000

# Worker 回调 Java 控制面
TRUSTAGENT_JAVA_BASE_URL=http://localhost:8080
TRUSTAGENT_JAVA_CALLBACK_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# 服务器演示部署（docker-compose.lowmem.yml 使用；本机开发不需要这些）
# 完整步骤见 docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------

# 【必填】镜像版本号。不允许 latest——出问题时无法判断线上跑的是哪一版。
# 由本地 scripts/build-release.ps1 生成，例如 v0.1.0-20260916-1200
TRUSTAGENT_IMAGE_TAG=

# 唯一对外的入口端口。只绑在宿主机 127.0.0.1，通过 SSH 隧道访问。
# 默认 8080 与后端自身端口相同，所以这里默认错开到 8090，避免隧道转发时混淆。
TRUSTAGENT_WEB_PORT=8090

# --- 可选：公网 HTTPS 模式（**默认不启用**）---
# 需要一个解析到本机公网 IP 的域名。没有可信证书就保持私有模式，
# 绝不要退回"公网明文 HTTP"（那会让登录口令与 JWT 明文过网）。
# 启用前必须先逐项通过 docs/DEPLOYMENT.md 的「公网模式检查清单」。
#
# 这两个变量**仅在公网模式需要**，私有模式下留空即可（compose 会把它们注入 web 容器，
# 空值不会影响 Caddyfile.private 的解析）。
#   TRUSTAGENT_PUBLIC_DOMAIN: deploy/Caddyfile.public 的站点主机名
#                              （{$TRUSTAGENT_PUBLIC_DOMAIN} { ... }，为空则 Caddy 启动失败）
#   TRUSTAGENT_ACME_EMAIL    : Let's Encrypt 账号邮箱，证书到期提醒发到这里
TRUSTAGENT_PUBLIC_DOMAIN=
TRUSTAGENT_ACME_EMAIL=

# --- 低配（1 核 2 GB）调优参数 ---
# 下面这些在 docker-compose.lowmem.yml 里有明确默认值，
# 通常不需要在 .env 里写；列出来是为了让你知道有哪些旋钮可调。

# 数据库连接池。每条 MySQL 连接在服务端也要占内存，演示场景 5 条足够。
TRUSTAGENT_DB_POOL_MAX=5
TRUSTAGENT_DB_POOL_MIN_IDLE=1

# Tomcat 工作线程。默认 200 是给多并发用户设计的，单用户演示 25 足够。
TRUSTAGENT_TOMCAT_MAX_THREADS=25
TRUSTAGENT_TOMCAT_MIN_SPARE=5
TRUSTAGENT_TOMCAT_MAX_CONNECTIONS=100
TRUSTAGENT_TOMCAT_ACCEPT_COUNT=50

# 评测相关上限。评测提交是最容易被误触的重操作，额度压到最低。
TRUSTAGENT_RL_EVAL_LIMIT=3
TRUSTAGENT_EVAL_MAX_CASES_PER_DATASET=200
TRUSTAGENT_EVAL_JOB_TIMEOUT_SECONDS=900
TRUSTAGENT_EVAL_BATCH_SIZE=10

# 上传体积上限（评测集是纯文本 JSONL，100 条约 30 KB）
TRUSTAGENT_MAX_UPLOAD_SIZE=2MB

# --- 本机 SSH 到达服务器的地址（仅 scripts/tunnel.ps1 与 bootstrap-ssh.ps1 使用）---
# 这两个值**不是给容器用的**，只被上面两个脚本读取。放在这里而不是写死在脚本里，
# 是因为硬编码的生产入口会随仓库一起传播，也会让"换服务器"变成一次代码改动。
# 不填也能用：脚本会要求你在命令行显式传 -Server/-User。
TRUSTAGENT_SSH_HOST=
TRUSTAGENT_SSH_USER=root
