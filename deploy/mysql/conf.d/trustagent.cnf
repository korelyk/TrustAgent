# MySQL 8 配置（仅本地/演示环境）
#
# 为什么必须显式声明字符集：
#   审计明细、Trace 摘要、评测用例里都有中文与 JSON 片段。
#   如果沿用镜像默认值，可能出现中文写入异常或排序结果与预期不一致，
#   而这类问题在演示时最难解释——所以在这里一次性定死。

[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# 审计链写入是"读上一条 + 写当前条"的串行小事务，评测结果是高频小事务。
# 演示环境适当放宽刷盘要求以提升写入速度；生产环境应保持默认的 1。
innodb_flush_log_at_trx_commit = 2

# 控制面 + Worker 的连接数并不高，200 足够且便于排查"连接被占满"类问题
max_connections = 200
