# ============================================================================
# MySQL 8.4 低配配置 —— 服务于「1 核 2 GB」演示部署（容器内存上限 512 MiB）
#
# 与 trustagent.cnf 的关系：
#   trustagent.cnf 是"默认/本地"配置，只定死字符集与刷盘策略；
#   本文件是"低配"配置，额外把 MySQL 的内存占用压到 512 MiB 容器内可稳定运行。
#   低配 compose 同时挂载两份，本文件靠后加载，因此同名项以本文件为准。
#
# 注意：这里的每一项都是"按官方文档推算 + 留安全余量"选的，
#       **没有在本机实测过实际 RSS**（本机 Docker 引擎不可用，见 docs/DEPLOYMENT.md 的验证状态）。
#       首次部署后请用 scripts/server/status.sh 观察真实占用，再按需调整。
# ============================================================================

[mysqld]

# ---- 字符集：中文/JSON 内容必须与默认配置保持一致，否则演示时最难解释 ----
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# ---------------------------------------------------------------------------
# 内存相关：这是 512 MiB 预算里省内存的关键几项
# ---------------------------------------------------------------------------

# performance_schema 默认开启，会为各类 instrument 预分配大量内存
# （实测常见 100~200 MiB 量级）。本项目不做数据库内部性能剖析，
# 关掉它对演示功能没有任何影响，却是省内存最有效的一项。
performance_schema = OFF

# 缓冲池是 InnoDB 最大的一块内存。演示数据量很小（评测结果 + 审计日志，
# 单次 100 条评测约 200 行），128 MiB 足够把热数据全放进去。
innodb_buffer_pool_size = 128M
# 实例数必须是 1：多实例时每实例至少要 128 MiB，留 1 个才能让上面这行真正生效
innodb_buffer_pool_instances = 1

# redo log 的容量（MySQL 8.0.30+ 用这个参数，取代了 innodb_log_file_size）。
# 它主要是磁盘占用，但恢复期会读进内存，演示环境不需要太大。
innodb_redo_log_capacity = 64M
innodb_log_buffer_size = 8M

# 临时表上限：评测报告 / 审计查询可能产生排序临时表，
# 调小避免单个查询把内存顶爆（超出部分会落到磁盘临时表，慢但不会 OOM）。
tmp_table_size = 16M
max_heap_table_size = 16M

# ---- 连接数：控制面只有一个 Hikari 池（本低配下 pool=5）----
# 留足余量给 Flyway 迁移、备份脚本、人工 mysql 客户端。
max_connections = 40
# 反查 DNS 会为每个连接分配额外内存，且演示环境没有内网 DNS 需求
skip_name_resolve = ON

# ---- 各类缓存：默认值是按"大内存服务器"设计的，按小数据量下调 ----
table_open_cache = 200
table_definition_cache = 200
key_buffer_size = 8M

# ---- 二进制日志：演示环境不做主从复制，关掉省内存也省磁盘 ----
skip_log_bin
max_allowed_packet = 16M

# ---------------------------------------------------------------------------
# 刷盘策略
# ---------------------------------------------------------------------------
# 审计链写入是"读上一条 + 写当前条"的串行小事务，评测结果是高频小事务。
# =2 表示"每次提交写 OS 缓存，每秒 fsync 一次"：崩溃可能丢最后 1 秒的事务。
# 演示环境接受这个窗口以换取写入速度；生产环境应保持默认的 1。
innodb_flush_log_at_trx_commit = 2

# 慢查询日志默认关；显式写出是为了防止镜像默认值变化导致意外写盘
slow_query_log = OFF
