# ============================================================================
# TrustAgent 公网 HTTPS 模式的反向代理 —— **模板，默认未启用**
#
# 启用前必须三条全部满足，缺一不可：
#   1. 已有一个解析到本服务器公网 IP 的域名（Let's Encrypt 不为裸 IP 签发证书）；
#   2. 已从外部网络实测浏览器地址栏是**锁形图标**、证书链被系统信任
#      （"http 能打开"不等于证书可信：中间人代理、自签证书都会给出不被信任的证书）；
#   3. 已逐项确认 docs/DEPLOYMENT.md 的「公网模式检查清单」全部通过。
#
# 没有可信证书时**保持私有模式**（SSH 隧道）。
# 绝不能退回"公网明文 HTTP"——那会让登录口令与 JWT 在公网上明文传输，
# 比"别人访问不到"糟糕得多。
#
# 启用方式：
#   1) 在 .env 里设置 TRUSTAGENT_PUBLIC_DOMAIN 与 TRUSTAGENT_ACME_EMAIL；
#   2) 把 docker-compose.lowmem.yml 里 web 服务的挂载从
#        ./deploy/Caddyfile.private:/etc/caddy/Caddyfile:ro
#      改为
#        ./deploy/Caddyfile.public:/etc/caddy/Caddyfile:ro
#   3) 把 web 服务的端口映射从 "127.0.0.1:8080:8080" 改为 "80:80" 与 "443:443"。
#
# 语法提示：Caddyfile 的注释符号是 "#"，不是 "//"。
# ============================================================================

{
	# 关闭 admin API（默认监听 localhost:2019，等于在线改配置的入口）
	admin off

	# ACME 账号邮箱：证书到期提醒发到这里。通过环境变量注入，不写死在文件里。
	email {$TRUSTAGENT_ACME_EMAIL}
}

# 域名通过环境变量注入。变量为空时这个站点块缺少主机名，Caddy 会直接启动失败——
# 这是刻意的"失败即停"：宁可起不来，也不要静默退化成一个谁都能访问的默认站点。
{$TRUSTAGENT_PUBLIC_DOMAIN} {
	# ---------------------------------------------------------------
	# 安全响应头
	# ---------------------------------------------------------------
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server

		# HSTS：告诉浏览器今后只用 HTTPS 访问本域名。
		# 只在证书已确认可用后再依赖它：一旦被浏览器记住，在 max-age 期间
		# 即使证书坏掉也无法退回 HTTP，用户会被锁在"无法访问"状态。
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	# ===============================================================
	# 访问控制：IP 白名单
	#
	# 为什么用 IP 白名单而不是 HTTP Basic 认证：
	#   本应用用 `Authorization: Bearer <JWT>`；HTTP Basic 用的是同一个请求头，
	#   两者叠加会互相覆盖，表现为"输对了密码仍然 401"。
	#   IP 白名单不占用任何请求头，与应用自身的认证机制天然不冲突。
	#
	# 写法说明（这里踩过一次坑）：
	#   必须用 **否定匹配器** 放在最前面。如果写成
	#       handle { respond @allowed }
	#   那第一个 handle 没有匹配器、会匹配**所有**请求并独占执行，
	#   后面的 handle 块永远到不了，等于白名单完全失效。
	#   用 `not remote_ip` 则：不在名单里 → 命中第一个 handle → 403；
	#   在名单里 → 不命中 → 继续往下走正常处理。
	#
	# 用法：把下面这行换成你自己的出口 IP。
	# 示例值 203.0.113.7 / 198.51.100.0/24 属于 RFC 5737 文档专用网段，
	# 在真实互联网上不存在，因此**不会被误放行**——必须替换才能访问。
	# 未替换时表现为：自己也访问不了（403），这是安全的那一侧失败。
	# ===============================================================
	@not_allowed not remote_ip 203.0.113.7 198.51.100.0/24
	handle @not_allowed {
		respond "Forbidden" 403
	}

	# ---------------------------------------------------------------
	# 内部接口：公网入口必须不存在
	# ---------------------------------------------------------------
	handle /internal/* {
		respond "Not Found" 404
	}

	# ---------------------------------------------------------------
	# 网关存活探针
	# ---------------------------------------------------------------
	handle /healthz {
		respond "ok" 200
	}

	# 后端健康检查：负载均衡/监控会用到，只返回 {"status":"UP"} 这类信息，
	# 不含配置、版本或依赖细节。
	handle /health {
		reverse_proxy backend:8080
	}

	# ---------------------------------------------------------------
	# 控制面接口
	# ---------------------------------------------------------------
	handle /api/* {
		reverse_proxy backend:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	# ---------------------------------------------------------------
	# OpenAPI 文档在公网模式下**显式拒绝**。
	#
	# 理由：Swagger UI 会把全部接口、参数结构、错误码摊开，等于免费给扫描者
	# 一份攻击面清单。私有模式保留它是为了面试展示；公网模式下它的收益（方便）
	# 远小于成本（暴露面）。
	# ---------------------------------------------------------------
	handle /swagger-ui* {
		respond "Not Found" 404
	}
	handle /v3/api-docs* {
		respond "Not Found" 404
	}

	# ---------------------------------------------------------------
	# 前端静态资源
	# ---------------------------------------------------------------
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
